# copy to .env (production, root) and to server/.env (local dev)
JWT_SECRET=change-me-long-random
DB_PASSWORD=change-me
DOMAIN=chat.example.com            # your domain (Caddy gets the HTTPS cert automatically)
PUBLIC_IP=1.2.3.4                  # server public IP (for TURN)
# --- TURN (calls across networks): coturn runs in docker-compose.prod.yml
TURN_SECRET=change-me-turn-secret
TURN_URL=turn:1.2.3.4:3478?transport=udp,turn:1.2.3.4:3478?transport=tcp
# --- Push notifications: run  npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com
# --- File storage (optional): any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze, MinIO). Empty = local disk
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_PUBLIC_URL=https://cdn.example.com   # public base URL of the bucket
